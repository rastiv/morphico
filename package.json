{
  "name": "morphico",
  "version": "0.3.0",
  "description": "Morphing line-art icons: smooth SVG path transitions between digits and other states. No dependencies.",
  "license": "MIT AND ISC",
  "author": "Raycho Ivanov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rastiv/morphico.git"
  },
  "homepage": "https://github.com/rastiv/morphico#readme",
  "bugs": {
    "url": "https://github.com/rastiv/morphico/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/morphico.mjs"
    }
  },
  "module": "./dist/morphico.mjs",
  "types": "./dist/types/index.d.ts",
  "jsdelivr": "./dist/morphico.js",
  "unpkg": "./dist/morphico.js",
  "files": [
    "dist",
    "LICENSE-lucide"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "node tools/serve.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tools/tsconfig.json",
    "build": "node tools/build.ts",
    "check": "node tools/check.ts",
    "verify": "node tools/verify.ts",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "keywords": [
    "icons",
    "svg",
    "morph",
    "animation",
    "digits",
    "countdown"
  ],
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
